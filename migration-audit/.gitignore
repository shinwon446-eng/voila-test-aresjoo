# 증거 그림과 원자료는 크다(스크린샷과 프레임만 수 GB, 파일 수만 개). 저장소에는 문서, 도구, 규칙, 요약만 넣는다.
# 원자료는 harness/README.md 의 명령으로 다시 만든다.
*.png
*.jpg
*.webp
*.webm

# 촬영 원본과 촬영마다의 기록
screenshots/before/
screenshots/after/
screenshots/cycle2-agy/
screenshots/cycle3-claude/
screenshots/r2-agy/
screenshots/r2-cycle3-claude/
screenshots/diff/**/*.json
screenshots/diff/**/*.txt

# 반복 촬영(한 빌드 안의 변종 재기)
qa/r2-repeat*/
qa/r3-repeat*/
qa/*.json

# 흐름과 연출의 실행 기록(비교 문서 .md 만 남긴다)
flows/**/*.json
motion/**/*.json

# 도구의 설치물과 실행 산출물
harness/node_modules/
harness/**/out/
harness/**/results/
harness/**/*.json
!harness/package.json
!harness/package-lock.json
!harness/classify-rules.json
!harness/golden/*.json

# 실행 로그(기준선과 마지막 검사, 빌드 로그만 남긴다)
logs/*
!logs/baseline-*.log
!logs/final3-*.log
!logs/build-before.log
!logs/build-final4.log
!logs/final4-run.log
